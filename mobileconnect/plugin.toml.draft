# MobileConnect plugin manifest -- DRAFT. Named .draft so that build_plugins.py neither builds nor lists this
# plugin: CI publishes every directory with a plugin.toml to the Marketplace on a push to main. Rename to
# plugin.toml when the owner decides to publish it.
#
# The server side of the iOS, Android and Meta Quest apps. Master node only.

name        = "mobileconnect"
version     = "0.1.0"
api_min     = "1"
api_max     = "1"
author      = "Gord Tulloch"
description = "Operate this observatory from the Galileo MobileConnect app on a tablet or phone"
tier        = "first_party"
nav_level   = "primary"
entry_point = "mobileconnect"
